  function initNeonWaves() {
      if(!canvasLayer || !mainPreview) return;
      canvasLayer.classList.remove('opacity-0');
      const canvas = canvasLayer as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if(!ctx) return;
      
      let width = mainPreview.clientWidth;
      let height = mainPreview.clientHeight;
      canvasLayer.width = width;
      canvasLayer.height = height;
      
      let mouse = { x: -1000, y: height/2 };
      
      const onMove = (e) => {
          const rect = mainPreview.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
      };
      mainPreview.addEventListener('mousemove', onMove);
      
      let time = 0;
      let animationId;
      
      function animate() {
          if(!ctx) return;
          ctx.clearRect(0,0,width,height);
          ctx.lineWidth = 2;
          
          const lines = 20;
          
          for(let i=0; i<lines; i++) {
              ctx.beginPath();
              let hue = (time + i * 10) % 360;
              ctx.strokeStyle = `hsl(${hue}, 70%, 50%)`;
              
              for(let x=0; x<width; x+=5) {
                  const dist = Math.abs(x - mouse.x);
                  const mouseInfluence = Math.max(0, (200 - dist) / 200);
                  
                  const y = height/2 + 
                            Math.sin(x * 0.01 + time * 0.05 + i * 0.5) * 50 +
                            (i - lines/2) * 10 + 
                            Math.sin(x * 0.05 + time * 0.1) * 50 * mouseInfluence;
                  
                  if(x===0) ctx.moveTo(x,y);
                  else ctx.lineTo(x,y);
              }
              ctx.stroke();
          }
          
          time += 0.5;
          animationId = requestAnimationFrame(animate);
      }
      animate();
      
      cleanupFunc = () => {
          mainPreview.removeEventListener('mousemove', onMove);
          cancelAnimationFrame(animationId);
      };
  }

  function initHexagonPulse() {
      if(cssLayer) {
          cssLayer.style.background = '#111';
          const grid = document.createElement('div');
          grid.className = 'w-full h-full flex flex-wrap justify-center align-content-center gap-0.5 overflow-hidden';
          cssLayer.appendChild(grid);

          const count = Math.ceil(window.innerWidth * window.innerHeight / 3000) * 1.5;
          for(let i=0; i<count; i++) {
              const hex = document.createElement('div');
              hex.className = 'w-[60px] h-[60px] bg-[#1a1a1a] relative transition-all duration-300';
              hex.style.clipPath = 'polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)';
              
              const inner = document.createElement('div');
              inner.className = 'absolute inset-[2px] bg-[#111] z-10';
              inner.style.clipPath = 'inherit';
              
              const pulse = document.createElement('div');
              pulse.className = 'absolute inset-0 bg-cyan-400 opacity-0 transition-opacity duration-500 z-20';
              
              hex.appendChild(inner);
              hex.appendChild(pulse);
              grid.appendChild(hex);
          }

          const pulses = grid.querySelectorAll('div > div:last-child');
          const onMove = (e) => {
          pulses.forEach((pulseEl) => {
              const pulse = pulseEl as HTMLElement;
              const hex = pulse.parentElement as HTMLElement;
              if(!hex) return;
              
              const rect = hex.getBoundingClientRect();
              const x = (e as MouseEvent).clientX - (rect.left + rect.width/2);
              const y = (e as MouseEvent).clientY - (rect.top + rect.height/2);
              const dist = Math.sqrt(x*x + y*y);
              
              if (dist < 150) {
                  pulse.style.opacity = (0.8 * (1 - dist/150)).toString();
                  hex.style.transform = `scale(${1 + (1 - dist/150) * 0.1})`;
              } else {
                  pulse.style.opacity = '0';
                  hex.style.transform = 'scale(1)';
              }
          });
          };
          mainPreview.addEventListener('mousemove', onMove);
          cleanupFunc = () => mainPreview.removeEventListener('mousemove', onMove);
      }
