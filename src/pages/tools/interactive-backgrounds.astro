  function initElasticStrings() {
      if(!canvasLayer || !mainPreview) return;
      canvasLayer.classList.remove('opacity-0');
      const canvas = canvasLayer as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if(!ctx) return;
      
      let w = canvasLayer.width = mainPreview.clientWidth;
      let h = canvasLayer.height = mainPreview.clientHeight;
      
      const strings = [];
      const count = 15;
      for(let i=0; i<count; i++) {
          strings.push({ y: (h / (count + 1)) * (i + 1), targetY: (h / (count + 1)) * (i + 1), vel: 0 });
      }

      let mouse = { x: -100, y: -100 };
      const onMove = (e) => {
          const rect = mainPreview.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
      };
      mainPreview.addEventListener('mousemove', onMove);

      let animationId;
      function animate() {
          ctx.clearRect(0,0,w,h);
          ctx.beginPath();
          ctx.strokeStyle = '#00ffcc';
          ctx.lineWidth = 1;
          
          strings.forEach(s => {
              const dist = Math.abs(mouse.y - s.y);
              if(dist < 50) {
                  const pull = (50 - dist) * (mouse.y > s.y ? 1 : -1) * 0.1;
                  s.vel += pull;
              }
              const spring = (s.targetY - s.y) * 0.1;
              s.vel += spring;
              s.vel *= 0.9;
              s.y += s.vel;
              
              ctx.moveTo(0, s.y);
              ctx.lineTo(w, s.y);
          });
          ctx.stroke();
          animationId = requestAnimationFrame(animate);
      }
      animate();
      cleanupFunc = () => {
          mainPreview.removeEventListener('mousemove', onMove);
          cancelAnimationFrame(animationId);
      };
  }

  function initMatrixRain() {
      if(!canvasLayer || !mainPreview) return;
      canvasLayer.classList.remove('opacity-0');
      const canvas = canvasLayer as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if(!ctx) return;
      
      let w = canvasLayer.width = mainPreview.clientWidth;
      let h = canvasLayer.height = mainPreview.clientHeight;
      
      const cols = Math.floor(w / 20) + 1;
      const ypos = Array(cols).fill(0);

      let animationId;
      function step() {
          ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
          ctx.fillRect(0, 0, w, h);
          ctx.fillStyle = '#0f0';
          ctx.font = '15pt monospace';
          
          ypos.forEach((y, ind) => {
              const text = String.fromCharCode(Math.random() * 128);
              const x = ind * 20;
              ctx.fillText(text, x, y);
              if (y > 100 + Math.random() * 10000) ypos[ind] = 0;
              else ypos[ind] = y + 20;
          });
          animationId = requestAnimationFrame(step);
      }
      step();
      cleanupFunc = () => cancelAnimationFrame(animationId);
  }

  function initFloatingBubbles() {
      if(!canvasLayer || !mainPreview) return;
      canvasLayer.classList.remove('opacity-0');
      const canvas = canvasLayer as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if(!ctx) return;
      
      let w = canvasLayer.width = mainPreview.clientWidth;
      let h = canvasLayer.height = mainPreview.clientHeight;
      
      const bubbles: any[] = [];
      class Bubble {
          x: number; y: number; size: number; speed: number; wobble: number;
          constructor() { this.reset(); this.y = Math.random() * h; }
          reset() {
              this.x = Math.random() * w;
              this.y = h + 20;
              this.size = Math.random() * 10 + 5;
              this.speed = Math.random() * 1 + 0.5;
              this.wobble = Math.random() * Math.PI * 2;
          }
          update() {
              this.y -= this.speed;
              this.wobble += 0.05;
              this.x += Math.sin(this.wobble) * 0.5;
              if (this.y < -20) this.reset();
          }
          draw() {
              ctx.strokeStyle = 'rgba(255,255,255,0.3)';
              ctx.fillStyle = 'rgba(255,255,255,0.1)';
              ctx.beginPath();
              ctx.arc(this.x, this.y, this.size, 0, Math.PI*2);
              ctx.fill();
              ctx.stroke();
          }
      }
      for(let i=0; i<50; i++) bubbles.push(new Bubble());

      let animationId;
      function animate() {
          ctx.clearRect(0,0,w,h);
          bubbles.forEach(b => { b.update(); b.draw(); });
          animationId = requestAnimationFrame(animate);
      }
      animate();
      cleanupFunc = () => cancelAnimationFrame(animationId);
  }

  function initDigitalGlitch() {
      if(cssLayer) {
          cssLayer.style.background = '#050505';
          const container = document.createElement('div');
          container.className = 'w-full h-full flex items-center justify-center';
          
          const text = document.createElement('div');
          text.className = 'text-7xl font-mono font-bold text-white relative tracking-[10px]';
          text.innerText = 'GLITCH';
          text.setAttribute('data-glitch', 'GLITCH');
          
          // Add custom style for glitch animation if not exists
          if(!document.getElementById('glitch-style')) {
              const style = document.createElement('style');
              style.id = 'glitch-style';
              style.innerHTML = `
                  [data-glitch]::before, [data-glitch]::after {
                      content: attr(data-glitch);
                      position: absolute; top:0; left:0; width: 100%; height: 100%; background: #050505;
                  }
                  [data-glitch]::before {
                      left: 2px; text-shadow: -2px 0 #ff00c1; clip: rect(44px, 450px, 56px, 0);
                      animation: glitch-anim 5s infinite linear alternate-reverse;
                  }
                  [data-glitch]::after {
                      left: -2px; text-shadow: -2px 0 #00fff9; clip: rect(44px, 450px, 56px, 0);
                      animation: glitch-anim2 5s infinite linear alternate-reverse;
                  }
                  @keyframes glitch-anim {
                      0% { clip: rect(31px, 9999px, 94px, 0); }
                      20% { clip: rect(62px, 9999px, 42px, 0); }
                      40% { clip: rect(16px, 9999px, 78px, 0); }
                      60% { clip: rect(81px, 9999px, 13px, 0); }
                      80% { clip: rect(92px, 9999px, 35px, 0); }
                      100% { clip: rect(13px, 9999px, 86px, 0); }
                  }
                  @keyframes glitch-anim2 {
                      0% { clip: rect(67px, 9999px, 24px, 0); }
                      20% { clip: rect(12px, 9999px, 87px, 0); }
                      40% { clip: rect(94px, 9999px, 12px, 0); }
                      60% { clip: rect(31px, 9999px, 63px, 0); }
                      80% { clip: rect(12px, 9999px, 95px, 0); }
                      100% { clip: rect(82px, 9999px, 12px, 0); }
                  }
              `;
              document.head.appendChild(style);
          }
          
          container.appendChild(text);
          cssLayer.appendChild(container);
          cleanupFunc = () => {};
      }
  }

  function initIsoLines() {
      if(!canvasLayer || !mainPreview) return;
      canvasLayer.classList.remove('opacity-0');
      const canvas = canvasLayer as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if(!ctx) return;
      
      let w = canvasLayer.width = mainPreview.clientWidth;
      let h = canvasLayer.height = mainPreview.clientHeight;
      
      let time = 0;
      let animationId;
      function animate() {
          ctx.fillStyle = '#000';
          ctx.fillRect(0,0,w,h);
          ctx.lineWidth = 1;
          ctx.strokeStyle = '#333';
          time += 0.005;
          
          for(let i=0; i<h; i+=25) {
              ctx.beginPath();
              for(let j=0; j<w; j+=25) {
                  const val = Math.sin(j*0.01 + time) * Math.cos(i*0.01 + time) * 40;
                  if(j===0) ctx.moveTo(j, i+val);
                  else ctx.lineTo(j, i+val);
              }
              ctx.stroke();
          }
          animationId = requestAnimationFrame(animate);
      }
      animate();
      cleanupFunc = () => cancelAnimationFrame(animationId);
  }

  function initSnowfall() {
      if(!canvasLayer || !mainPreview) return;
      canvasLayer.classList.remove('opacity-0');
      const canvas = canvasLayer as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if(!ctx) return;
      
      let w = canvasLayer.width = mainPreview.clientWidth;
      let h = canvasLayer.height = mainPreview.clientHeight;
      
      const flakes: any[] = [];
      class Flake {
          x: number; y: number; vx: number; vy: number; size: number;
          constructor() { this.reset(); this.y = Math.random() * h; }
          reset() {
              this.x = Math.random() * w;
              this.y = -10;
              this.vx = Math.random() - 0.5;
              this.vy = Math.random() * 1 + 1;
              this.size = Math.random() * 2 + 1;
          }
          update(wind: number) {
              this.x += this.vx + wind;
              this.y += this.vy;
              if (this.y > h) this.reset();
              if (this.x > w) this.x = 0;
              if (this.x < 0) this.x = w;
          }
          draw() {
              ctx.fillStyle = 'rgba(255,255,255,0.7)';
              ctx.beginPath();
              ctx.arc(this.x, this.y, this.size, 0, Math.PI*2);
              ctx.fill();
          }
      }
      for(let i=0; i<150; i++) flakes.push(new Flake());

      let lastX = 0, wind = 0;
      const onMove = (e) => {
          wind = (e.clientX - lastX) * 0.05;
          lastX = e.clientX;
      };
      mainPreview.addEventListener('mousemove', onMove);

      let animationId;
      function animate() {
          ctx.clearRect(0,0,w,h);
          wind *= 0.95;
          flakes.forEach(f => { f.update(wind); f.draw(); });
          animationId = requestAnimationFrame(animate);
      }
      animate();
      cleanupFunc = () => {
          mainPreview.removeEventListener('mousemove', onMove);
          cancelAnimationFrame(animationId);
      };
  }

  function initLaserBeam() {
      if(!canvasLayer || !mainPreview) return;
      canvasLayer.classList.remove('opacity-0');
      const canvas = canvasLayer as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if(!ctx) return;
      
      let w = canvasLayer.width = mainPreview.clientWidth;
      let h = canvasLayer.height = mainPreview.clientHeight;
      
      let mouse = { x: w/2, y: h/2 };
      const onMove = (e) => {
          const rect = mainPreview.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
      };
      mainPreview.addEventListener('mousemove', onMove);

      let animationId;
      function animate() {
          ctx.fillStyle = 'rgba(0,0,0,0.2)';
          ctx.fillRect(0,0,w,h);
          
          ctx.shadowBlur = 15;
          ctx.shadowColor = '#ff0000';
          ctx.strokeStyle = '#ff0000';
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(w/2, h/2);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.stroke();
          
          ctx.shadowBlur = 0;
          ctx.fillStyle = '#fff';
          ctx.beginPath();
          ctx.arc(mouse.x, mouse.y, 4, 0, Math.PI*2);
          ctx.fill();
          
          animationId = requestAnimationFrame(animate);
      }
      animate();
      cleanupFunc = () => {
          mainPreview.removeEventListener('mousemove', onMove);
          cancelAnimationFrame(animationId);
      };
  }

  // Handle Resize
  window.addEventListener('resize', () => {
      if(currentEffect) {
          const active = currentEffect;
          const name = styleName.innerText;
          clearEffect(true);
          setTimeout(() => loadEffect(active, name), 100);
      }
  });

</script>
