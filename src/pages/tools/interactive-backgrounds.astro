      type: 'canvas',
      description: 'Sine waves that react to cursor proximity.',
      code: `<!-- HTML -->
<canvas id="neon-waves"></canvas>

<style>
#neon-waves {
  background: #000;
  width: 100%;
  height: 100vh;
}
</style>

<script>
const canvas = document.getElementById('neon-waves');
const ctx = canvas.getContext('2d');
let width, height;
let time = 0;

function resize() {
  width = canvas.width = window.innerWidth;
  height = canvas.height = window.innerHeight;
}

let mouse = { x: -1000, y: 0 };
canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
});

function animate() {
    ctx.clearRect(0,0,width,height);
    ctx.lineWidth = 2;
    const lines = 20;
    
    for(let i=0; i<lines; i++) {
        ctx.beginPath();
        let hue = (time + i * 10) % 360;
        ctx.strokeStyle = \`hsl(\${hue}, 70%, 50%)\`;
        
        for(let x=0; x<width; x+=5) {
            const dist = Math.abs(x - mouse.x);
            const mouseInfluence = Math.max(0, (200 - dist) / 200);
            
            const y = height/2 + 
                      Math.sin(x * 0.01 + time * 0.05 + i * 0.5) * 50 +
                      (i - lines/2) * 10 + 
                      Math.sin(x * 0.05 + time * 0.1) * 50 * mouseInfluence;
            
            if(x===0) ctx.moveTo(x,y);
            else ctx.lineTo(x,y);
        }
        ctx.stroke();
    }
    time += 0.5;
    requestAnimationFrame(animate);
}

window.addEventListener('resize', resize);
resize();
animate();
<\/script>`
