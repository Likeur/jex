      description: 'Elements that flee from the cursor nearby.',
      code: `<!-- HTML -->
<div id="magnetic-grid"></div>

<style>
#magnetic-grid {
  width: 100%;
  height: 100vh;
  background: #111;
  display: grid;
  grid-template-columns: repeat(40, 0.5fr);
  grid-template-rows: repeat(20, 0.5fr);
  overflow: hidden;
}
.magnetic-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
}
.magnetic-dot {
  width: 2px; 
  height: 2px; 
  background: white; 
  border-radius: 50%;
  opacity: 0.3;
  transition: transform 0.2s cubic-bezier(0.2, 0, 0.2, 1);
}
</style>

<script>
const grid = document.getElementById('magnetic-grid');
const dots = [];

// Create grid
for(let i=0; i<800; i++) {
  const wrapper = document.createElement('div');
  wrapper.className = 'magnetic-wrapper';
  const dot = document.createElement('div');
  dot.className = 'magnetic-dot';
  wrapper.appendChild(dot);
  grid.appendChild(wrapper);
  dots.push(dot);
}

document.addEventListener('mousemove', (e) => {
  const rect = grid.getBoundingClientRect();
  const mx = e.clientX - rect.left;
  const my = e.clientY - rect.top;
  
  dots.forEach(dot => {
      const dotRect = dot.getBoundingClientRect();
      // Calculate dot center relative to grid
      const dotX = (dotRect.left + dotRect.width/2) - rect.left;
      const dotY = (dotRect.top + dotRect.height/2) - rect.top;
      
      const dx = dotX - mx;
      const dy = dotY - my;
      const dist = Math.sqrt(dx*dx + dy*dy);
      
      if(dist < 150) {
          const strength = (150 - dist) / 150;
          const tx = dx * strength * 0.8;
          const ty = dy * strength * 0.8;
          dot.style.transform = \`translate(\${tx}px, \${ty}px)\`;
          dot.style.opacity = '1';
      } else {
          dot.style.transform = 'translate(0,0)';
          dot.style.opacity = '0.3';
      }
  });
});
<\/script>`
