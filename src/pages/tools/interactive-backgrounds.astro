    name: 'Vortex Particles',
    id: 'vortex-particles',
    type: 'canvas',
    description: 'Particles swirling into a central vortex.',
    code: `<!-- HTML -->
<canvas id="vortex-canvas"></canvas>

<style>
#vortex-canvas {
  background: #000;
  width: 100%;
  height: 100vh;
}
</style>

<script>
const canvas = document.getElementById('vortex-canvas');
const ctx = canvas.getContext('2d');
let w, h;
const particles = [];

function resize() {
  w = canvas.width = window.innerWidth;
  h = canvas.height = window.innerHeight;
}

class Particle {
  constructor() {
    this.reset();
  }
  reset() {
    this.x = Math.random() * w;
    this.y = Math.random() * h;
    this.angle = Math.atan2(this.y - h/2, this.x - w/2);
    this.dist = Math.sqrt(Math.pow(this.x - w/2, 2) + Math.pow(this.y - h/2, 2));
    this.size = Math.random() * 2;
    this.speed = Math.random() * 0.05 + 0.01;
  }
  update() {
    this.angle += this.speed;
    this.dist -= 1;
    if(this.dist < 0) this.reset();
    
    this.x = w/2 + Math.cos(this.angle) * this.dist;
    this.y = h/2 + Math.sin(this.angle) * this.dist;
  }
  draw() {
    ctx.fillStyle = \`rgba(100, 200, 255, \${this.dist / 300})\`;
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.size, 0, Math.PI*2);
    ctx.fill();
  }
}

for(let i=0; i<300; i++) particles.push(new Particle());

function animate() {
  ctx.fillStyle = 'rgba(0,0,0,0.1)';
  ctx.fillRect(0,0,w,h);
  particles.forEach(p => { p.update(); p.draw(); });
  requestAnimationFrame(animate);
}

window.addEventListener('resize', resize);
resize();
animate();
<\/script>`
