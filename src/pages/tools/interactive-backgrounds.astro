          div.className = `stars-layer absolute inset-[-100px] layer-${i} pointer-events-none`;
          div.style.backgroundSize = `${i * 100}px ${i * 100}px`;
          div.style.backgroundImage = "radial-gradient(circle, white 2px, transparent 3px)";
          div.style.opacity = (0.5 + i * 0.2).toString(); // Increased opacity
          if(cssLayer) cssLayer.appendChild(div);
      });
      
      const onMove = (e) => {
          const rect = mainPreview.getBoundingClientRect();
