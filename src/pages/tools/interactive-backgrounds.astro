  function initVortexParticles() {
      if(!canvasLayer || !mainPreview) return;
      canvasLayer.classList.remove('opacity-0');
      const canvas = canvasLayer as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if(!ctx) return;
      
      let w = canvasLayer.width = mainPreview.clientWidth;
      let h = canvasLayer.height = mainPreview.clientHeight;
      
      const particles: any[] = [];
      const count = 300;
      
      class Particle {
          x: number; y: number; angle: number; dist: number; size: number; speed: number;
          constructor() { this.reset(); }
          reset() {
              this.x = Math.random() * w;
              this.y = Math.random() * h;
              this.angle = Math.atan2(this.y - h/2, this.x - w/2);
              this.dist = Math.sqrt(Math.pow(this.x - w/2, 2) + Math.pow(this.y - h/2, 2));
              this.size = Math.random() * 2;
              this.speed = Math.random() * 0.05 + 0.01;
          }
          update() {
              this.angle += this.speed;
              this.dist -= 1;
              if(this.dist < 0) this.reset();
              this.x = w/2 + Math.cos(this.angle) * this.dist;
              this.y = h/2 + Math.sin(this.angle) * this.dist;
          }
          draw() {
              ctx.fillStyle = `rgba(100, 200, 255, ${this.dist / 300})`;
              ctx.beginPath();
              ctx.arc(this.x, this.y, this.size, 0, Math.PI*2);
              ctx.fill();
          }
      }

      for(let i=0; i<count; i++) particles.push(new Particle());

      let animationId;
      function animate() {
          ctx.fillStyle = 'rgba(0,0,0,0.1)';
          ctx.fillRect(0,0,w,h);
          particles.forEach(p => { p.update(); p.draw(); });
          animationId = requestAnimationFrame(animate);
      }
      animate();
      
      cleanupFunc = () => {
          cancelAnimationFrame(animationId);
      };
  }

  function initRetroGrid() {
