      name: 'Elastic Strings',
      id: 'elastic-strings',
      type: 'canvas',
      description: 'Interact with strings that bounce back.',
      code: `<!-- HTML -->
<canvas id="strings-canvas"></canvas>

<style>
#strings-canvas { margin: 0; padding: 0; background: #222; width: 100%; height: 100vh; }
</style>

<script>
const canvas = document.getElementById('strings-canvas');
const ctx = canvas.getContext('2d');
let w, h;
let strings = [];
let mouse = {x: -100, y: -100};

function resize(){
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
    initStrings();
}

function initStrings(){
    strings = [];
    for(let i=50; i<h; i+=50){
        strings.push({y: i, targetY: i, vel: 0});
    }
}

canvas.addEventListener('mousemove', e => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
});

function animate(){
    ctx.clearRect(0,0,w,h);
    
    // Draw strings
    ctx.beginPath();
    strings.forEach(s => {
        // Physics
        const dist = Math.abs(mouse.y - s.y);
        if(dist < 50 && Math.abs(mouse.x - w/2) < w) {
            // Simple pull effect
            if(mouse.y > s.y) s.vel += 1;
            else s.vel -= 1;
        }
        
        // Spring back
        const force = (s.targetY - s.y) * 0.1;
        s.vel += force;
        s.vel *= 0.9; // damping
        s.y += s.vel;
        
        ctx.moveTo(0, s.y);
        // Bezier curve for smooth bend? complicated, let's just do line
        ctx.lineTo(w, s.y);
    });
    ctx.strokeStyle = '#00ffcc';
    ctx.stroke();
    
    requestAnimationFrame(animate);
}
window.addEventListener('resize', resize);
resize();
animate();
<\/script>`
