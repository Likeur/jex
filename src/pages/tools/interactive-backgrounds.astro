          grid.style.backgroundImage = 'linear-gradient(rgba(255,0,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,0,255,0.4) 1px, transparent 1px)';
          grid.style.backgroundSize = '40px 40px';
