      const container = document.createElement('div');
      container.className = 'w-full h-full p-px bg-[#222] overflow-hidden';
      if(cssLayer) cssLayer.appendChild(container);
      
      // Calculate active area size
      const rect = mainPreview.getBoundingClientRect();
