          const y = (e.clientY - rect.top) - rect.height/2;
          
          layers.forEach(i => {
              if(cssLayer) {
                const layer = cssLayer.querySelector(`.layer-${i}`);
                if(layer) layer.style.transform = `translate(${-x * i * 0.05}px, ${-y * i * 0.05}px)`;
