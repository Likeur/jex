<script>
  const backgroundsData = window.backgroundsData;
  let currentEffect = null;
  let cleanupFunc = null;
  const mainPreview = document.getElementById('main-preview');
  const cssLayer = document.getElementById('css-layer');
  const canvasLayer = document.getElementById('canvas-layer');
  const styleName = document.getElementById('active-style-name');
  const fullscreenBtn = document.getElementById('fullscreen-btn');
  const resetBtn = document.getElementById('reset-btn');
  
  // Initialize with first effect
  setTimeout(() => loadEffect('mouse-gradient', 'Mouse Gradient'), 100);

  // Card Click Handler
  document.querySelectorAll('.bg-card-item').forEach(card => {
    card.addEventListener('click', (e) => {
        const target = e.target;
        if(target.closest('.copy-code-btn')) return;
        
        const id = card.dataset.id;
        const name = card.dataset.name;
        if(id) loadEffect(id, name);
    });
  });

  // Copy Code Handler
  document.querySelectorAll('.copy-code-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
         e.stopPropagation();
         const button = e.currentTarget;
         const id = button.dataset.id;
         
         const bgData = backgroundsData.find(b => b.id === id);
         const code = bgData ? bgData.code : '/* Code not found */';
         
         try {
             await copyToClipboard(code);
             
             // Success feedback
             const originalText = button.innerText;
             button.innerText = 'Copied!';
             button.classList.add('bg-green-100', 'text-green-700', 'border-green-200');
             
             setTimeout(() => {
                 button.innerText = originalText;
                 button.classList.remove('bg-green-100', 'text-green-700', 'border-green-200');
             }, 2000);
         } catch (err) {
             console.error('Copy failed:', err);
             button.innerText = 'Error!';
             setTimeout(() => button.innerText = 'Copy Code', 2000);
         }
      });
  });

  async function copyToClipboard(text) {
      // 1. Try modern Clipboard API
      if (navigator.clipboard && navigator.clipboard.writeText) {
          try {
              await navigator.clipboard.writeText(text);
              return;
          } catch (err) {
              console.warn('Clipboard API failed, trying fallback...');
          }
      }
      
      // 2. Fallback to textArea method
      const textArea = document.createElement("textarea");
      textArea.value = text;
      
      // Ensure it's not visible but part of DOM
      textArea.style.position = "fixed";
      textArea.style.left = "-9999px";
      textArea.style.top = "0";
      document.body.appendChild(textArea);
      
      textArea.focus();
      textArea.select();
      
      try {
          const successful = document.execCommand('copy');
          document.body.removeChild(textArea);
          if (!successful) throw new Error('execCommand failed');
      } catch (err) {
          document.body.removeChild(textArea);
          throw err;
      }
  }



  // Fullscreen Handler
  if(fullscreenBtn) {
      fullscreenBtn.addEventListener('click', () => {
          if (!document.fullscreenElement) {
              mainPreview.requestFullscreen().then(() => {
                  // Reload effect after fullscreen transition
                  setTimeout(() => {
                      if(currentEffect) {
                         const active = currentEffect;
                         clearEffect(true);
                         loadEffect(active, styleName.innerText);
                      }
                  }, 100);
              }).catch(err => {
                  console.error(`Error attempting to enable fullscreen: ${err.message}`);
              });
          } else {
              document.exitFullscreen();
          }
      });
  }

  // Listen for fullscreen change events to handle exit fullscreen
  document.addEventListener('fullscreenchange', () => {
      setTimeout(() => {
          if(currentEffect) {
              const active = currentEffect;
              clearEffect(true);
              loadEffect(active, styleName.innerText);
          }
      }, 100);
  });
  
  if(resetBtn) {
      resetBtn.addEventListener('click', () => {
         if(currentEffect) {
             const active = currentEffect;
             const name = styleName.innerText;
             clearEffect(true);
             setTimeout(() => loadEffect(active, name), 50);
         }
      });
  }

  function clearEffect(resetCurrent = false) {
      if(cleanupFunc) cleanupFunc();
      cleanupFunc = null;
      if(resetCurrent) currentEffect = null;
      
      if (cssLayer) {
        cssLayer.innerHTML = '';
        cssLayer.className = 'absolute inset-0 w-full h-full transition-opacity duration-300 overflow-hidden';
        cssLayer.removeAttribute('style');
      }
      
      if (canvasLayer) {
        const ctx = canvasLayer.getContext('2d');
        if (ctx) ctx.clearRect(0, 0, canvasLayer.width, canvasLayer.height);
        canvasLayer.classList.add('opacity-0');
      }
  }

  function loadEffect(id, name) {
      if(currentEffect === id) return;
      clearEffect(false); 
      currentEffect = id;
      if(name && styleName) styleName.innerText = name;
      
      if (!mainPreview) return;
      
      switch(id) {
          case 'mouse-gradient': initMouseGradient(); break;
          case 'spotlight': initSpotlight(); break;
          case 'constellation': initConstellation(); break;
          case 'grid-ripple': initGridRipple(); break;
          case 'parallax': initParallax(); break;
          case 'magnetic': initMagnetic(); break;
          case 'glow-board': initGlowBoard(); break;
          case 'pixel-trail': initPixelTrail(); break;
          case '3d-tilt': init3DTilt(); break;
          case 'neon-waves': initNeonWaves(); break;
          case 'hexagon-pulse': initHexagonPulse(); break;
          case 'vortex-particles': initVortexParticles(); break;
          case 'retro-grid': initRetroGrid(); break;
          case 'elastic-strings': initElasticStrings(); break;
          case 'matrix-rain': initMatrixRain(); break;
          case 'floating-bubbles': initFloatingBubbles(); break;
          case 'digital-glitch': initDigitalGlitch(); break;
          case 'iso-lines': initIsoLines(); break;
          case 'snowfall': initSnowfall(); break;
          case 'laser-beam': initLaserBeam(); break;
      }
  }

  // Effect Implementations
  
  function initMouseGradient() {
      if(cssLayer) cssLayer.style.background = '#000';
      const blob = document.createElement('div');
      blob.style.cssText = `
        position: absolute; top: 0; left: 0; width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(100,100,255,0.4) 0%, transparent 70%);
        transform: translate(-50%, -50%); pointer-events: none; mix-blend-mode: screen;
      `;
