<canvas id="iso-canvas"></canvas>

<style>
#iso-canvas { width: 100%; height: 100vh; background: #fff; filter: invert(1); }
</style>

<script>
const canvas = document.getElementById('iso-canvas');
const ctx = canvas.getContext('2d');
let w, h, time = 0;

function resize(){ w=canvas.width=window.innerWidth; h=canvas.height=window.innerHeight; }

function noise(x,y) { return Math.sin(x) * Math.cos(y); } // Simple pseudo noise

function animate(){
    ctx.clearRect(0,0,w,h);
    ctx.lineWidth = 1;
    ctx.strokeStyle = '#000';
    time += 0.005;
    
    for(let i=0; i<h; i+=20) {
        ctx.beginPath();
        for(let j=0; j<w; j+=20) {
            const val = noise(j*0.01 + time, i*0.01 + time) * 50;
            if(j===0) ctx.moveTo(j, i+val);
            else ctx.lineTo(j, i+val);
        }
        ctx.stroke();
    }
    requestAnimationFrame(animate);
}
window.addEventListener('resize', resize);
resize();
animate();
<\/script>`
