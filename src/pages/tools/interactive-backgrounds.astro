  function initSpotlight() {
      if(cssLayer) {
        cssLayer.style.backgroundColor = '#000';
      }
      
      // Pattern Layer
      const pattern = document.createElement('div');
      pattern.className = 'absolute inset-0 pointer-events-none';
      pattern.style.backgroundImage = 'radial-gradient(#444 1px, transparent 1px)';
      pattern.style.backgroundSize = '30px 30px';
