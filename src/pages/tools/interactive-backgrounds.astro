      container.appendChild(grid);
      
      const cards = [];
      
      for(let i=0; i<cols*rows; i++) {
          const card = document.createElement('div');
          card.className = 'bg-[#151515] relative w-full h-full glow-card';
          // Inner glow element
          const glow = document.createElement('div');
          glow.className = 'glow-effect absolute inset-0 transition-opacity duration-300 pointer-events-none opacity-0';
          glow.style.background = 'radial-gradient(circle at center, rgba(255,255,255,0.15), transparent 70%)';
          card.appendChild(glow);
          
          grid.appendChild(card);
          cards.push(card);
      }
      
      const onMove = (e) => {
         // Per-card update for reliability
         cards.forEach(card => {
            const r = card.getBoundingClientRect();
            const x = e.clientX - r.left;
            const y = e.clientY - r.top;
            
            // Allow glow to show if mouse is near
            const glow = card.querySelector('.glow-effect');
            if(glow) {
                // Calculate distance from center of card for better feel
                const dist = Math.hypot(x - r.width/2, y - r.height/2);
                if(dist < 150) {
                     glow.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.15), transparent 70%)`;
                     glow.style.opacity = '1';
                } else {
                     glow.style.opacity = '0';
                }
            }
         });
      };

      mainPreview.addEventListener('mousemove', onMove);
      cleanupFunc = () => {
          mainPreview.removeEventListener('mousemove', onMove);
      };
  }

  function initPixelTrail() {
      if(canvasLayer) canvasLayer.classList.remove('opacity-0');
      const ctx = canvasLayer.getContext('2d');
      if(!ctx) return;
      
      let width = mainPreview.clientWidth;
      let height = mainPreview.clientHeight;
      canvasLayer.width = width;
      canvasLayer.height = height;
      
      const trail = [];
      
      const onMove = (e) => {
          const rect = mainPreview.getBoundingClientRect();
          trail.push({
              x: e.clientX - rect.left,
              y: e.clientY - rect.top,
              age: 1.0,
              size: Math.random() * 10 + 5,
              color: `hsl(${Math.random()*360}, 100%, 50%)` 
          });
      };
      mainPreview.addEventListener('mousemove', onMove);
      
      let animationId;
      function animate() {
          if(!ctx) return;
          ctx.clearRect(0,0,width,height);
          
          for(let i=trail.length-1; i>=0; i--) {
              const p = trail[i];
              p.age -= 0.02;
              if(p.age <= 0) {
                  trail.splice(i, 1);
                  continue;
              }
              
              ctx.fillStyle = p.color;
              ctx.globalAlpha = p.age;
              ctx.fillRect(p.x - p.size/2, p.y - p.size/2, p.size, p.size);
          }
          ctx.globalAlpha = 1;
          animationId = requestAnimationFrame(animate);
      }
      animate();
      
      cleanupFunc = () => {
          mainPreview.removeEventListener('mousemove', onMove);
          cancelAnimationFrame(animationId);
      };
  }

  function init3DTilt() {
