  function initMagnetic() {
      if(cssLayer) {
        cssLayer.style.background = '#111';
        cssLayer.style.display = 'grid';
        cssLayer.style.gridTemplateColumns = 'repeat(40 , 0.5fr)';
        cssLayer.style.gridTemplateRows = 'repeat(20, 0.5fr)';
      }
      
      const dots = [];
      for(let i=0; i<800; i++) {
          const dotWrapper = document.createElement('div');
          dotWrapper.className = 'flex items-center justify-center';
          const dot = document.createElement('div');
          dot.className = 'w-1 h-1 bg-white rounded-full magnetic-dot opacity-30';
          dotWrapper.appendChild(dot);
          if(cssLayer) cssLayer.appendChild(dotWrapper);
          dots.push(dot);
      }
      
      const onMove = (e) => {
          const rect = mainPreview.getBoundingClientRect();
          const mx = e.clientX - rect.left;
          const my = e.clientY - rect.top;
          
          dots.forEach(dot => {
              const dotRect = dot.getBoundingClientRect();
              const dx = (dotRect.left + dotRect.width/2) - (rect.left + mx);
              const dy = (dotRect.top + dotRect.height/2) - (rect.top + my);
              const dist = Math.sqrt(dx*dx + dy*dy);
              
              if(dist < 100) {
                  const strength = (100 - dist) / 100;
                  const tx = dx * strength * 0.5;
                  const ty = dy * strength * 0.5;
                  dot.style.transform = `translate(${tx}px, ${ty}px)`;
                  dot.style.opacity = '1';
              } else {
                  dot.style.transform = 'translate(0,0)';
                  dot.style.opacity = '0.3';
              }
          });
      };
      
      mainPreview.addEventListener('mousemove', onMove);
      cleanupFunc = () => mainPreview.removeEventListener('mousemove', onMove);
  }

  function initGlowBoard() {
